generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum UserRole { SUPER_ADMIN ORG_ADMIN HR_ADMIN LOCATION_ADMIN SUPERVISOR PAYROLL_ADMIN CONTRACTOR_ADMIN EMPLOYEE }
enum EmployeeStatus { ACTIVE INACTIVE }
enum LocationStatus { ACTIVE INACTIVE }
enum AttendanceEventType { CHECK_IN CHECK_OUT BREAK_START BREAK_END GEOFENCE_ENTER GEOFENCE_EXIT MANUAL_CORRECTION SYSTEM_EVENT }
enum EventSource { WEB PWA MOBILE OFFLINE SYSTEM }
enum AttendanceStatus { PRESENT ABSENT HALF_DAY LATE EARLY_EXIT WEEKLY_OFF HOLIDAY PAID_LEAVE UNPAID_LEAVE ON_DUTY MISSING_PUNCH GEOFENCE_EXCEPTION PENDING_APPROVAL CORRECTED }
enum ApprovalStatus { PENDING APPROVED REJECTED }
enum LeaveDayType { FULL_DAY HALF_DAY }
enum PayrollPeriodStatus { OPEN PROCESSING LOCKED EXPORTED }

model Organization { id String @id @default(cuid()); name String; code String @unique; timezone String @default("Asia/Kolkata"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; users User[]; employees Employee[]; locations Location[]; contractors Contractor[]; projects Project[]; shifts Shift[]; leaveTypes LeaveType[]; holidays Holiday[]; payrollPeriods PayrollPeriod[]; auditLogs AuditLog[] }
model User { id String @id @default(cuid()); organizationId String?; email String; passwordHash String; name String; role UserRole; active Boolean @default(true); organization Organization? @relation(fields:[organizationId], references:[id], onDelete: SetNull); employee Employee?; auditLogs AuditLog[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([organizationId,email]) }
model Employee { id String @id @default(cuid()); organizationId String; employeeCode String; payrollCode String?; firstName String; lastName String?; mobile String?; email String?; dateOfJoining DateTime?; status EmployeeStatus @default(ACTIVE); departmentId String?; designationId String?; contractorId String?; organization Organization @relation(fields:[organizationId], references:[id], onDelete: Cascade); department Department? @relation(fields:[departmentId], references:[id], onDelete:SetNull); designation Designation? @relation(fields:[designationId], references:[id], onDelete:SetNull); contractor Contractor? @relation(fields:[contractorId], references:[id], onDelete:SetNull); user User?; assignments LocationAssignment[]; devices Device[]; events AttendanceEvent[]; days AttendanceDay[]; corrections AttendanceCorrection[]; leaveRequests LeaveRequest[]; overtime Overtime[]; @@unique([organizationId,employeeCode]); @@index([organizationId,status]) }
model Department { id String @id @default(cuid()); organizationId String; name String; employees Employee[]; @@unique([organizationId,name]) }
model Designation { id String @id @default(cuid()); organizationId String; name String; employees Employee[]; @@unique([organizationId,name]) }
model Contractor { id String @id @default(cuid()); organizationId String; name String; code String; organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade); employees Employee[]; @@unique([organizationId,code]) }
model Project { id String @id @default(cuid()); organizationId String; name String; code String; organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade); locations Location[]; @@unique([organizationId,code]) }
model Location { id String @id @default(cuid()); organizationId String; projectId String?; name String; code String; address String?; latitude Decimal @db.Decimal(10,7); longitude Decimal @db.Decimal(10,7); timezone String @default("Asia/Kolkata"); status LocationStatus @default(ACTIVE); organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade); project Project? @relation(fields:[projectId],references:[id],onDelete:SetNull); geofence Geofence?; assignments LocationAssignment[]; events AttendanceEvent[]; @@unique([organizationId,code]) }
model Geofence { id String @id @default(cuid()); locationId String @unique; latitude Decimal @db.Decimal(10,7); longitude Decimal @db.Decimal(10,7); radiusMeters Int @default(150); active Boolean @default(true); location Location @relation(fields:[locationId],references:[id],onDelete:Cascade) }
model Device { id String @id; employeeId String; platform String; deviceName String?; status String @default("ACTIVE"); registeredAt DateTime @default(now()); lastSeenAt DateTime?; employee Employee @relation(fields:[employeeId],references:[id],onDelete:Cascade); @@index([employeeId,status]) }
model Shift { id String @id @default(cuid()); organizationId String; name String; startTime String; endTime String; graceMinutes Int @default(15); breakDurationMinutes Int @default(0); minimumHoursForHalfDay Decimal @default(4) @db.Decimal(5,2); minimumHoursForFullDay Decimal @default(8) @db.Decimal(5,2); active Boolean @default(true); organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade); assignments LocationAssignment[]; @@unique([organizationId,name]) }
model LocationAssignment { id String @id @default(cuid()); employeeId String; locationId String; shiftId String?; effectiveFrom DateTime; effectiveTo DateTime?; employee Employee @relation(fields:[employeeId],references:[id],onDelete:Cascade); location Location @relation(fields:[locationId],references:[id],onDelete:Cascade); shift Shift? @relation(fields:[shiftId],references:[id],onDelete:SetNull); @@index([employeeId,effectiveFrom,effectiveTo]) }
model AttendanceEvent { id String @id @default(cuid()); eventUuid String @unique; employeeId String; locationId String?; type AttendanceEventType; source EventSource; occurredAt DateTime; serverReceivedAt DateTime @default(now()); latitude Decimal? @db.Decimal(10,7); longitude Decimal? @db.Decimal(10,7); accuracyMeters Decimal? @db.Decimal(8,2); geofenceDistanceMeters Decimal? @db.Decimal(10,2); geofenceStatus String?; deviceId String?; metadata Json?; employee Employee @relation(fields:[employeeId],references:[id],onDelete:Cascade); location Location? @relation(fields:[locationId],references:[id],onDelete:SetNull); @@index([employeeId,occurredAt]); @@index([locationId,occurredAt]) }
model AttendanceDay { id String @id @default(cuid()); employeeId String; date DateTime; checkIn DateTime?; checkOut DateTime?; workedHours Decimal @default(0) @db.Decimal(7,2); breakHours Decimal @default(0) @db.Decimal(7,2); lateMinutes Int @default(0); earlyExitMinutes Int @default(0); overtimeHours Decimal @default(0) @db.Decimal(7,2); status AttendanceStatus; payableDayValue Decimal @default(0) @db.Decimal(5,2); lopDayValue Decimal @default(0) @db.Decimal(5,2); exceptionReason String?; calculatedAt DateTime @default(now()); employee Employee @relation(fields:[employeeId],references:[id],onDelete:Cascade); @@unique([employeeId,date]); @@index([date,status]) }
model AttendanceCorrection { id String @id @default(cuid()); employeeId String; date DateTime; requestedCheckIn DateTime?; requestedCheckOut DateTime?; reason String; status ApprovalStatus @default(PENDING); requestedBy String; approvedBy String?; requestedAt DateTime @default(now()); approvedAt DateTime?; originalValue Json?; newValue Json?; employee Employee @relation(fields:[employeeId],references:[id],onDelete:Cascade); @@index([employeeId,date,status]) }
model Approval { id String @id @default(cuid()); organizationId String; type String; entityId String; status ApprovalStatus @default(PENDING); requestedBy String; approvedBy String?; reason String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([organizationId,type,status]) }
model LeaveType { id String @id @default(cuid()); organizationId String; name String; paid Boolean @default(true); organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade); requests LeaveRequest[]; @@unique([organizationId,name]) }
model LeaveRequest { id String @id @default(cuid()); employeeId String; leaveTypeId String; date DateTime; dayType LeaveDayType; status ApprovalStatus @default(PENDING); reason String?; employee Employee @relation(fields:[employeeId],references:[id],onDelete:Cascade); leaveType LeaveType @relation(fields:[leaveTypeId],references:[id],onDelete:Cascade); @@index([employeeId,date,status]) }
model Holiday { id String @id @default(cuid()); organizationId String; name String; date DateTime; organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade); @@unique([organizationId,date]) }
model Overtime { id String @id @default(cuid()); employeeId String; date DateTime; hours Decimal @db.Decimal(7,2); source String; status ApprovalStatus @default(PENDING); requestedBy String; approvedBy String?; employee Employee @relation(fields:[employeeId],references:[id],onDelete:Cascade); @@index([employeeId,date,status]) }
model PayrollPeriod { id String @id @default(cuid()); organizationId String; year Int; month Int; status PayrollPeriodStatus @default(OPEN); lockedAt DateTime?; lockedBy String?; organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade); exports PayrollExport[]; @@unique([organizationId,year,month]) }
model PayrollExport { id String @id @default(cuid()); payrollPeriodId String; format String; rowCount Int; createdAt DateTime @default(now()); createdBy String; payrollPeriod PayrollPeriod @relation(fields:[payrollPeriodId],references:[id],onDelete:Cascade) }
model AuditLog { id String @id @default(cuid()); organizationId String?; actorUserId String?; action String; entity String; entityId String?; before Json?; after Json?; ipAddress String?; metadata Json?; createdAt DateTime @default(now()); organization Organization? @relation(fields:[organizationId],references:[id],onDelete:SetNull); actor User? @relation(fields:[actorUserId],references:[id],onDelete:SetNull); @@index([organizationId,createdAt]) }
